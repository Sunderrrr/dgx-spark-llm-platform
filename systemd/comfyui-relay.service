[Unit]
Description=Relais socat 172.19.0.1:8188 -> 127.0.0.1:8188 (ComfyUI vers le portail docker)
# ComfyUI listens on loopback only (comfyui.service). This relay exposes only
# the docker bridge address (172.19.0.1) the portal targets, without reopening
# 0.0.0.0. The vllm-restrict.service firewall still DROPs 8188 for the rest
# (wt0/netbird included).
#
# BindsTo + PartOf: the relay follows EXACTLY comfyui's lifecycle — comfyui
# on-demand stopped via Admin → relay stops cleanly (no more phantom « failed »);
# comfyui restarted → relay comes back with it, without starting the relay on
# its own.
After=comfyui.service network.target
BindsTo=comfyui.service
PartOf=comfyui.service

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:8188,bind=172.19.0.1,reuseaddr,fork TCP:127.0.0.1:8188
Restart=always
RestartSec=5

[Install]
# Follows comfyui (on-demand): do NOT enable this one either, otherwise the
# relay would try to start alone at boot (and fail without comfyui). No real
# WantedBy.
WantedBy=multi-user.target
