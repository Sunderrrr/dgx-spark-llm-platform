[Unit]
Description=vLLM Runner — DGX Portal daemon
After=network.target

[Service]
Type=simple
User=vllmrunner
Group=vllmrunner
WorkingDirectory=/root/ai-platform/vllm-runner
EnvironmentFile=/root/ai-platform/.env
ExecStart=/usr/bin/python3 /root/ai-platform/vllm-runner/runner.py
Restart=always
# 30 s et non 5 : le pilote NVIDIA rend la memoire GPU d'un processus tue avec
# RETARD. Relance en 5 s, le runner rechargeait son modele par-dessus une memoire
# pas encore rendue -> nouvel OOM -> boucle (45 redemarrages le 2026-10-01).
RestartSec=30
# Un OOM qui touche le llama-server ne doit PAS tuer tout le runner : avec le
# defaut `stop`, systemd arretait le service entier, le portail perdait le runner
# et chaque redemarrage relancait le modele. En `continue`, le runner reste debout,
# constate la sortie du modele et laisse le watchdog decider, avec attente
# memoire, plancher et compteur d'echecs persiste (cf. runner.py).
OOMPolicy=continue
Environment=VLLM_BIN=/root/.local/bin/vllm
Environment=HF_HOME=/root/.cache/huggingface
Environment=HOME=/var/lib/vllm-runner
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
