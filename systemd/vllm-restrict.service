[Unit]
Description=Host perimeter: vLLM (8000), vllm-runner (8001), decisions (8002) and ComfyUI (8188) local-only, never reachable over the VPN
# Two layers.
#
# 1. filter/INPUT: 8000, 8001, 8002 and 8188 accept localhost and the
#    ai-platform docker bridge (the portal reaches them via 172.19.0.1), drop
#    the rest. 8002 is the decision model (Cloudflare Clef), a second
#    llama-server the runner starts on demand: LiteLLM reaches it on the same
#    bridge, exactly like :8000, and nobody else does.
#
# 2. raw/PREROUTING, chain DGX-PERIMETER: the VPN (netbird, `wt0`) rules.
#    They used to live in filter/INPUT and LOST THE RACE every time: netbird
#    re-inserts its blanket `-i wt0 -j ACCEPT` at the top of INPUT whenever
#    it reconfigures, so our DROP sat below it with 0 packets (measured
#    2026-09-17 and again 2026-10-13: any VPN peer reached the
#    unauthenticated :8000 and :8188). `raw` is evaluated BEFORE `filter` and
#    netbird does not touch it, so the order can no longer drift.
#    wt0 → 8000/8001/8002/8188: DROP (no VPN peer has any use for them).
#    Site-specific rules (e.g. LiteLLM published with DGX_LITELLM_PUBLISH and
#    admitted from wt0 only) belong in a machine-local drop-in
#    (`vllm-restrict.service.d/*.conf`, ExecStartPost appending to
#    DGX-PERIMETER): ExecStart rebuilds the chain from scratch, ExecStop
#    removes it whole, drop-in rules included.
#
# Comments stay OUT of ExecStart: systemd joins the `\` lines into ONE shell
# line, so a `#` inside the script comments out everything after it (this is
# what silently disabled the final wt0 rule of the previous version).
After=network.target docker.service netbird.service
Wants=netbird.service
PartOf=netbird.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '\
for PORT in 8000 8001 8002 8188; do \
  iptables -C INPUT -p tcp --dport $PORT -j DROP 2>/dev/null || iptables -I INPUT -p tcp --dport $PORT -j DROP; \
  iptables -C INPUT -p tcp --dport $PORT -s 172.19.0.0/16 -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport $PORT -s 172.19.0.0/16 -j ACCEPT; \
  iptables -C INPUT -p tcp --dport $PORT -s 127.0.0.1 -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport $PORT -s 127.0.0.1 -j ACCEPT; \
done; \
iptables -D INPUT -i wt0 -p tcp -m multiport --dports 8000,8001,8002,8188 -j DROP 2>/dev/null || true; \
iptables -t raw -N DGX-PERIMETER 2>/dev/null || iptables -t raw -F DGX-PERIMETER; \
iptables -t raw -A DGX-PERIMETER -i lo -j RETURN; \
iptables -t raw -A DGX-PERIMETER -i wt0 -p tcp -m multiport --dports 8000,8001,8002,8188 -j DROP; \
iptables -t raw -C PREROUTING -j DGX-PERIMETER 2>/dev/null || iptables -t raw -I PREROUTING 1 -j DGX-PERIMETER'
ExecStop=/bin/sh -c '\
for PORT in 8000 8001 8002 8188; do \
  iptables -D INPUT -p tcp --dport $PORT -j DROP 2>/dev/null || true; \
  iptables -D INPUT -p tcp --dport $PORT -s 172.19.0.0/16 -j ACCEPT 2>/dev/null || true; \
  iptables -D INPUT -p tcp --dport $PORT -s 127.0.0.1 -j ACCEPT 2>/dev/null || true; \
done; \
iptables -t raw -D PREROUTING -j DGX-PERIMETER 2>/dev/null || true; \
iptables -t raw -F DGX-PERIMETER 2>/dev/null || true; \
iptables -t raw -X DGX-PERIMETER 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
