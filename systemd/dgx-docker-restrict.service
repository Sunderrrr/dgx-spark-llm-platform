[Unit]
Description=Filter Docker-published host ports by source (sources from /etc/default/dgx-firewall)
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Which ports and which sources is site configuration: it lives in
# /etc/default/dgx-firewall (template: systemd/dgx-firewall.example), never in
# the repository. Without that file, nothing is filtered here.
EnvironmentFile=-/etc/default/dgx-firewall
ExecStart=/usr/local/sbin/dgx-docker-restrict.sh start
ExecStop=/usr/local/sbin/dgx-docker-restrict.sh stop

[Install]
WantedBy=multi-user.target
