# Scoped control of the music sidecar, modelled on the OCR/voice/image
# entries: vllm-runner (unprivileged) can only start/stop/inspect the pinned
# `music` container, read its logs (pinned tail), and run the recreation script
# whose argument is revalidated on the Python side before any sudo call.
# Install in /etc/sudoers.d/vllmrunner-music (root:root, 0440).
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker start music
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker stop music
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker inspect music
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker logs --tail 400 music
vllmrunner ALL=(root) NOPASSWD: /usr/local/sbin/music-recreate.sh *
