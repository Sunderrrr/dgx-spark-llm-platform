[Unit]
# Traefik runs in a `restart: unless-stopped` container (outside this repo,
# under /opt/traefik) started by dockerd — which can start BEFORE DNS is
# ready. At boot, Traefik then fails to fetch its plugins (GitHub) and the
# Cloudflare ACME challenge does not complete: routing broken, 404 on the
# site. This service waits for real DNS resolution then restarts Traefik ONCE,
# so those network fetches succeed. It is the automation of the manual
# `docker restart traefik` that fixed the symptom.
#
# Deliberately in systemd and not in /opt/traefik: the Traefik config files
# (docker-compose.yml, dynamic/routes.yml) are rewritten by the
# traefik-manager-agent and would be overwritten. This boot guard survives it.
Description=Redémarre Traefik une fois au boot, quand le DNS est prêt (corrige la course plugins/ACME)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Wait up to 120 s for the hosts Traefik needs to resolve, then restart the
# container. `|| true`: with no `traefik` container (other machine), the
# service stays a harmless no-op.
ExecStart=/bin/sh -c 'for i in $(seq 1 60); do if getent hosts github.com >/dev/null 2>&1 && getent hosts api.cloudflare.com >/dev/null 2>&1; then break; fi; sleep 2; done; /usr/bin/docker restart traefik >/dev/null 2>&1 || true'

[Install]
WantedBy=multi-user.target
