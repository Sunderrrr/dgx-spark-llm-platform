[Unit]
Description=ComfyUI — moteur de génération vidéo MiniMax H3 (backend interne, non exposé)
After=network.target

[Service]
Type=simple
User=vllmrunner
Group=vllmrunner
WorkingDirectory=/root/ComfyUI
# Loopback uniquement : le portail (conteneur docker) l'atteint via le relais
# socat comfyui-relay.service qui écoute sur 172.19.0.1:8188. Plus de
# 0.0.0.0 — le moteur vidéo sans auth n'est joignable que depuis l'hôte.
ExecStart=/root/venvs/comfyui/bin/python3 main.py --listen 127.0.0.1 --port 8188
Restart=always
RestartSec=5
Environment=HOME=/var/lib/vllm-runner
Environment=HF_HOME=/root/.cache/huggingface

[Install]
# ON-DEMAND : ne PAS `systemctl enable` ce service. ComfyUI (MiniMax H3) est un
# sidecar média on-demand (~33 Go de VRAM) lancé UNIQUEMENT via Admin →
# POST /video/start (le runner fait `systemctl start comfyui`). L'enabler force
# son chargement à chaque boot, gaspillant la VRAM au profit du chat. Un service
# disabled reste démarrable manuellement, donc /video/start continue de marcher.
WantedBy=multi-user.target
