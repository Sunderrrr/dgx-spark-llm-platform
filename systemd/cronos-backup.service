[Unit]
Description=CrOS backup — SQLite portail + Postgres LiteLLM
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# Runs as root: access to the docker socket (container dumps).
ExecStart=/usr/bin/python3 /root/ai-platform/monitoring/backup.py --dir /var/backups/cronos
TimeoutStartSec=300
# Hardening (2026-09-24): see cronos-monitor.service. Here writes are limited
# to the dumps (`/var/backups/cronos`); the PostgreSQL dump goes through the
# docker daemon, so the CLI needs no capability.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/cronos /root/.docker
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
