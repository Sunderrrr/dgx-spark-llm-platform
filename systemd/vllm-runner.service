[Unit]
Description=vLLM Runner — DGX Portal daemon
After=network.target

[Service]
Type=simple
User=vllmrunner
Group=vllmrunner
WorkingDirectory=/root/ai-platform/vllm-runner
EnvironmentFile=/root/ai-platform/.env
ExecStart=/usr/bin/python3 /root/ai-platform/vllm-runner/runner.py
Restart=always
# 30 s and not 5: the NVIDIA driver returns a killed process's GPU memory with
# a DELAY. Relaunching after 5 s, the runner reloaded its model on top of
# memory not yet returned → new OOM → loop (45 restarts on 2026-10-01).
RestartSec=30
# An OOM hitting the llama-server must NOT kill the whole runner: with the
# default `stop`, systemd stopped the whole service, the portal lost the runner
# and every restart relaunched the model. In `continue`, the runner stays up,
# notices the model's exit and lets the watchdog decide, with memory wait,
# floor and persisted failure counter (see runner.py).
OOMPolicy=continue
Environment=VLLM_BIN=/root/.local/bin/vllm
Environment=HF_HOME=/root/.cache/huggingface
Environment=HOME=/var/lib/vllm-runner
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
