# ── Generated by setup.sh (do not edit these 3 lines by hand) ──
LITELLM_MASTER_KEY=sk-changeme
POSTGRES_PASSWORD=changeme
# DO NOT KEEP « changeme »: setup.sh replaces this line with a
# secrets.token_urlsafe(32). The portal now REFUSES to start with fewer than
# 32 characters (or a sample value): this key signs the session cookies, so
# whoever knows it can forge an administrator session.
WEBUI_SECRET_KEY=changeme

# ── Authentik — create an OIDC app "litellm" in Authentik ──
AUTHENTIK_LITELLM_CLIENT_ID=litellm
AUTHENTIK_LITELLM_CLIENT_SECRET=changeme

# ── LDAP (Authentik) — login of the portal accounts ──
LDAP_URI=ldap://100.73.45.103:389
LDAP_BASE=dc=cronos,dc=lan
LDAP_BIND_DN=cn=ldap,ou=users,dc=cronos,dc=lan
LDAP_BIND_PW=changeme

# ── SSO / OIDC of the dgx portal (Authentik app "dgx") ──
# Redirect URI to declare in Authentik: https://dgx.cronos.website/api/oauth2-redirect
# Post-logout redirect URI to declare in Authentik: https://dgx.cronos.website/
OIDC_METADATA_URL=https://gjallarhorn.cronos.website/application/o/dgx/.well-known/openid-configuration
OIDC_CLIENT_ID=dgx
OIDC_CLIENT_SECRET=changeme
OIDC_REDIRECT_URI=https://dgx.cronos.website/api/oauth2-redirect
OIDC_LOGOUT_URL=https://gjallarhorn.cronos.website/application/o/dgx/end-session/
OIDC_ADMIN_GROUP=adm_cronos

# ── Discord ──
# Webhook (admin alerts: model / budget requests).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/qsdqd/qsdqsd
# Announcement DMs to users (model change, announcements, maintenance…).
# The bot DMs every user who linked their account; the client id/secret drive
# the OAuth2 linking. Everything is optional — absent → the feature is off.
#   1. https://discord.com/developers/applications → New Application
#   2. Bot → Reset Token → DISCORD_BOT_TOKEN ; invite the bot to your server
#   3. OAuth2 → Client ID / Client Secret ; add the redirect below
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://cronos.website/discord/callback

# ── Token budget — enforced by LiteLLM, not by the portal ──
# Default cap of an account, in TOKENS (models are priced 1/token: input and
# output count the same). Deliberately weekly: an omitted duration turns the
# cap into a lifelong cap, so every budget write carries the duration. An
# account can be granted an override (amount + deadline); beyond 1e12 tokens
# the request is refused (a mis-typed approval once left an account de-facto
# unlimited).
KEY_MAX_BUDGET=200000000
KEY_BUDGET_DURATION=7d

# ── vLLM Runner — auth token between dgx-portal and vllm-runner ──
RUNNER_TOKEN=changeme

# ── Runner: engines and locations ──
# The runner launches a single chat model at a time, on one of these three
# engines. The values below are the ones it will use if nothing is set; this
# deployment points LLAMA_BIN at /root/atomic-llama/build/bin/
# llama-server (a symlink to the upstream build) — a path resolved at every
# launch, so changeable without restarting the runner.
LLAMA_BIN=/root/llama.cpp/build/bin/llama-server
VLLM_BIN=/root/.local/bin/vllm
DS4_BIN=/root/ds4-nvfp4-spark/ds4-server
MODELS_DIR=/root/models
HF_HOME=/root/.cache/huggingface
# Simultaneous launches allowed on the runner side (downloads included).
MAX_JOBS=4

# ── LDAP: where to look up accounts ──
# LDAP_BASE + LDAP_USERS_DN give the search base, LDAP_LOGIN_ATTR is the
# attribute compared with the name typed at login.
LDAP_USERS_DN=ou=users
LDAP_LOGIN_ATTR=cn

# ── Portal sessions ──
# Session lifetime (seconds) and cookie Secure flag. Keep
# SECURE=1: the portal is reachable over HTTPS only.
SESSION_MAX_AGE=43200
SESSION_COOKIE_SECURE=1

# ── Web search (SearXNG) ──
SEARXNG_SECRET=changeme

# ── Email SMTP ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton@gmail.com
SMTP_PASSWORD=mot-de-passe-appqsd
SMTP_FROM=DGX Spark qsdqsdqsd@gmail.Com
ADMIN_EMAIL=ton@email.com
# Admin dashboard URL, for the « Open the Admin dashboard » button in the
# emails. Empty → no button is rendered.
ADMIN_URL=https://dgx.cronos.website/admin
# Anti-spam for the « demander un modèle » button (seconds): 1 request per
# account and per media category within that window, beyond that the route
# answers 429.
MEDIA_REQUEST_COOLDOWN_S=1800

# ── Passkeys (WebAuthn/FIDO2) — optional 2nd factor, local + LDAP only ──
# The passkey is bound to the ORIGIN: a key declared on one domain does not
# work on the other (dgx.cronos.website vs dgx.cronos.lan). REQUIRE_UV=1
# requires a PIN or biometrics; at 0, a « touch-only » YubiKey is enough.
WEBAUTHN_ORIGIN=https://dgx.cronos.website
WEBAUTHN_RP_ID=dgx.cronos.website
WEBAUTHN_RP_NAME=Cronos
WEBAUTHN_REQUIRE_UV=0

# ── Hugging Face downloads ──
# Only required for « gated » repos (some GGUFs are): without an authorized
# token, the download fails with « Access denied ».
HF_TOKEN=

# ── Internal endpoints ──
# The values below are already the code's defaults: only set them if a service
# moves (container renamed, port changed).
# VLLM_RUNNER_URL and VLLM_API_URL go through host.docker.internal, pinned to
# 172.19.0.1 on the compose side — do not replace it with host-gateway (see
# CLAUDE.md, the local, unpublished guide).
VLLM_RUNNER_URL=http://host.docker.internal:8001
VLLM_API_URL=http://host.docker.internal:8000/v1
VLLM_API_BASE=http://host.docker.internal:8000/v1
# Port 4001: it is the one THIS stack runs LiteLLM on
# (docker-compose.yml, `--port 4001`) and the one Traefik uses. The fallback
# written in the code is 4000 (LiteLLM's upstream default): do not rely on it,
# it does not answer here.
LITELLM_URL=http://litellm:4001
OCR_URL=http://ocr:8000/v1
VOICE_URL=http://voice:8004
ASR_URL=http://asr:8006
IMAGE_URL=http://image:8007
MUSIC_URL=http://music:8008
COMFYUI_URL=http://host.docker.internal:8188
SEARXNG_URL=http://searxng:8080
CRAWL4AI_URL=http://crawl4ai:11235
# Public API URL, shown in the playground's integration snippets.
PUBLIC_API_URL=https://api.cronos.website/v1
# LiteLLM alias that always follows the current model: clients wire it once
# and never rename it on every switch.
AUTO_MODEL_NAME=auto-model
# Timezone displayed by the portal (the server can stay on UTC).
TZ_DISPLAY=Europe/Paris
