[Unit]
Description=Empeche le conteneur OCR d'ouvrir une connexion vers le portail
# The OCR container is the ONLY one running with --trust-remote-code: a
# malicious HF repo (chosen by an admin from the catalog) executes arbitrary
# code in it. Yet dgx-portal is multi-homed on ocr_net and carries in its
# environment LITELLM_MASTER_KEY, RUNNER_TOKEN, LDAP_BIND_PW, OIDC_CLIENT_SECRET,
# SECRET_KEY and SMTP_PASSWORD.
#
# Recount on 2026-09-13: out of 146 portal routes, 11 are unguarded — the
# login flow, CSRF, forwardAuth, /healthz, /metrics (refused with 403 as soon
# as the request crosses the Cloudflare edge) and the shared view of a
# conversation. Two of them therefore return data, but no account data —
# immediate exploitability stays nil. This blocking is defense in depth: the
# day an unauthenticated route or an SSRF appears, it must not be reachable
# from third-party model code.
#
# ebtables and not iptables: br_netfilter is not loaded, so traffic between two
# containers of the SAME bridge does not traverse iptables. Enabling it would
# subject all container-to-container traffic at once to the existing DOCKER-USER
# rules (DROP on 3000/2376/8080/8090) — too risky. The L2 filter is targeted at
# this single bridge.
#
# Only port 5000 (the one the portal LISTENS on) is blocked: the filter is
# stateless, and blocking all ocr->portal would break the RESPONSES of the
# legitimate portal->ocr:8000 flow, which come back on an ephemeral port.
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ocr-restrict.sh add
ExecStop=/usr/local/sbin/ocr-restrict.sh del

[Install]
WantedBy=multi-user.target
