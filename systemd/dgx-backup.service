[Unit]
Description=DGX backup (data, configuration, identity) to the S3 bucket
After=network-online.target docker.service
Wants=network-online.target

# scripts/backup.sh: consistent SQLite copies, Postgres dump, compose file,
# .env and secrets, archived and uploaded to DGX_S3_BUCKET, then listed back
# from the bucket before the run counts as a success. It also refreshes the
# local state the admin panel reads (/var/backups/dgx).
# No sandboxing here (unlike dgx-monitor.service): the script needs the
# docker socket, /tmp, the repository's secrets/ and the s3cmd config.
[Service]
Type=oneshot
ExecStart=/root/ai-platform/scripts/backup.sh
Nice=10
