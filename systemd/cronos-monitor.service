[Unit]
Description=CrOS health monitor — alerte email quand les services cœur sont down
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# Runs as root: the .env (600) and the docker socket are accessible there.
ExecStart=/usr/bin/python3 /root/ai-platform/monitoring/monitor.py
TimeoutStartSec=60
# Hardening (2026-09-24): the unit runs as root with none of these
# capabilities being of any use to it. `ProtectSystem=strict` makes the whole
# filesystem read-only (the .env stays READABLE, `ProtectHome=read-only` does
# not hide it) and `ReadWritePaths` opens only what the monitor writes: its
# sticky state, and `/root/.docker` (the docker CLI touches its buildx state
# there).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cronos-monitor /root/.docker
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
