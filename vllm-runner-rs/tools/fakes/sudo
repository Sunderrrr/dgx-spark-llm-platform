#!/bin/bash
# A stand-in for the scoped sudo: the answers the real host gives the runner's calls.
[ "$1" = "-n" ] && shift
case "$*" in
  "/usr/bin/docker inspect ocr"|"/usr/bin/docker inspect image")
    echo '[{"State": {"Running": true}}]'; exit 0 ;;
  "/usr/bin/docker inspect voice"|"/usr/bin/docker inspect asr")
    echo '[{"State": {"Running": false}}]'; exit 0 ;;
  "/usr/bin/docker inspect "*) echo "Error: No such object" >&2; exit 1 ;;
  "/usr/bin/docker start "*|"/usr/bin/docker stop "*) echo "${*##* }"; exit 0 ;;
  "/usr/bin/docker logs --tail 400 "*) echo "container line 1"; echo "container line 2" >&2; exit 0 ;;
  "/usr/bin/systemctl is-active comfyui.service") echo active; exit 0 ;;
  "/usr/bin/systemctl start comfyui.service"|"/usr/bin/systemctl stop comfyui.service") echo "done"; exit 0 ;;
  "/usr/bin/journalctl -u comfyui.service -n 400 --no-pager") echo "comfy log"; exit 0 ;;
  "/usr/local/sbin/model-files-rm.sh local absent-model"|"/usr/local/sbin/model-files-rm.sh hf org/absent")
    echo "absent"; exit 1 ;;
  "/usr/local/sbin/model-files-rm.sh hf org/busy"*) echo "disk busy"; exit 1 ;;
  "/usr/local/sbin/model-files-rm.sh"*) echo "removed"; echo "3221225472"; exit 0 ;;
  "/usr/local/sbin/"*) echo "recreated: $*"; exit 0 ;;
  *) echo "unexpected: $*" >&2; exit 2 ;;
esac
