[Unit]
Description=ComfyUI — moteur de génération vidéo MiniMax H3 (backend interne, non exposé)
After=network.target

[Service]
Type=simple
User=vllmrunner
Group=vllmrunner
WorkingDirectory=/root/ComfyUI
# Loopback only: the portal (docker container) reaches it via the socat relay
# comfyui-relay.service listening on 172.19.0.1:8188. No more 0.0.0.0 — the
# unauthenticated video engine is reachable only from the host.
ExecStart=/root/venvs/comfyui/bin/python3 main.py --listen 127.0.0.1 --port 8188
Restart=always
RestartSec=5
Environment=HOME=/var/lib/vllm-runner
Environment=HF_HOME=/root/.cache/huggingface

[Install]
# ON-DEMAND: do NOT `systemctl enable` this service. ComfyUI (MiniMax H3) is an
# on-demand media sidecar (~33 GB of VRAM) started ONLY via Admin →
# POST /video/start (the runner runs `systemctl start comfyui`). Enabling it
# forces its loading at every boot, wasting VRAM at chat's expense. A disabled
# service can still be started manually, so /video/start keeps working.
WantedBy=multi-user.target
