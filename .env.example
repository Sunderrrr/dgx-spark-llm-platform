# ── Généré par setup.sh (ne pas éditer manuellement ces 3 lignes) ──
LITELLM_MASTER_KEY=sk-changeme
POSTGRES_PASSWORD=changeme
WEBUI_SECRET_KEY=changeme

# ── Authentik — créer une app OIDC "litellm" dans Authentik ──
AUTHENTIK_LITELLM_CLIENT_ID=litellm
AUTHENTIK_LITELLM_CLIENT_SECRET=changeme

# ── LDAP (Authentik) — connexion des comptes du portail ──
LDAP_URI=ldap://100.73.45.103:389
LDAP_BASE=dc=cronos,dc=lan
LDAP_BIND_DN=cn=ldap,ou=users,dc=cronos,dc=lan
LDAP_BIND_PW=changeme

# ── SSO / OIDC du portail dgx (app Authentik "dgx") ──
# Redirect URI à déclarer dans Authentik : https://dgx.cronos.website/api/oauth2-redirect
# Post-logout redirect URI à déclarer dans Authentik : https://dgx.cronos.website/
OIDC_METADATA_URL=https://gjallarhorn.cronos.website/application/o/dgx/.well-known/openid-configuration
OIDC_CLIENT_ID=dgx
OIDC_CLIENT_SECRET=changeme
OIDC_REDIRECT_URI=https://dgx.cronos.website/api/oauth2-redirect
OIDC_LOGOUT_URL=https://gjallarhorn.cronos.website/application/o/dgx/end-session/
OIDC_ADMIN_GROUP=adm_cronos

# ── Discord ──
# Webhook (admin alerts : demandes de modèle / de budget).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/qsdqd/qsdqsd
# DM d'annonces aux utilisateurs (changement de modèle, annonces, maintenance…).
# Le bot DM chaque user ayant lié son compte ; le client id/secret pilotent la
# liaison OAuth2. Tout est optionnel — absents → la fonctionnalité est inactive.
#   1. https://discord.com/developers/applications → New Application
#   2. Bot → Reset Token → DISCORD_BOT_TOKEN ; invite le bot sur ton serveur
#   3. OAuth2 → Client ID / Client Secret ; ajoute la redirection ci-dessous
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://cronos.website/discord/callback

# ── Token budget — appliqué par LiteLLM, pas par le portail ──
# Plafond par défaut d'un compte, en TOKENS (les modèles sont tarifés 1/token :
# entrée et sortie comptent pareil). Volontairement hebdomadaire : une durée
# omise transforme le plafond en plafond à vie, donc toute écriture de budget
# porte la durée. Un compte peut recevoir une dérogation (montant + échéance) ;
# au-delà de 1e12 tokens la demande est refusée (une approbation mal saisie a
# déjà mis un compte de fait en illimité).
KEY_MAX_BUDGET=200000000
KEY_BUDGET_DURATION=7d

# ── vLLM Runner — auth token entre dgx-portal et vllm-runner ──
RUNNER_TOKEN=changeme

# ── Runner : moteurs et emplacements ──
# Le runner lance un seul modèle de chat à la fois, sur l'un de ces trois
# moteurs. Les valeurs ci-dessous sont celles qu'il utilisera si rien n'est
# renseigné ; ce déploiement pointe LLAMA_BIN vers /root/atomic-llama/build/bin/
# llama-server (un lien vers le build upstream) — un chemin résolu à chaque
# lancement, donc modifiable sans redémarrer le runner.
LLAMA_BIN=/root/llama.cpp/build/bin/llama-server
VLLM_BIN=/root/.local/bin/vllm
DS4_BIN=/root/ds4-nvfp4-spark/ds4-server
MODELS_DIR=/root/models
HF_HOME=/root/.cache/huggingface
# Lancements simultanés autorisés côté runner (téléchargements compris).
MAX_JOBS=4

# ── LDAP : où chercher les comptes ──
# LDAP_BASE + LDAP_USERS_DN donnent le point de recherche, LDAP_LOGIN_ATTR
# l'attribut comparé au nom saisi à la connexion.
LDAP_USERS_DN=ou=users
LDAP_LOGIN_ATTR=cn

# ── Sessions du portail ──
# Durée de vie d'une session (secondes) et drapeau Secure du cookie. Laisser
# SECURE=1 : le portail n'est joignable qu'en HTTPS.
SESSION_MAX_AGE=43200
SESSION_COOKIE_SECURE=1

# ── Recherche web (SearXNG) ──
SEARXNG_SECRET=changeme

# ── Email SMTP ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton@gmail.com
SMTP_PASSWORD=mot-de-passe-appqsd
SMTP_FROM=DGX Spark qsdqsdqsd@gmail.Com
ADMIN_EMAIL=ton@email.com
# URL du dashboard admin, pour le bouton « Open the Admin dashboard » des
# emails. Vide → aucun bouton n'est rendu.
ADMIN_URL=https://dgx.cronos.website/admin
# Anti-spam du bouton « demander un modèle » (secondes) : 1 demande par compte
# et par catégorie média dans cette fenêtre, au-delà la route répond 429.
MEDIA_REQUEST_COOLDOWN_S=1800

# ── Passkeys (WebAuthn/FIDO2) — 2e facteur optionnel, local + LDAP seulement ──
# La passkey est liée à l'ORIGINE : une clé déclarée sur un domaine ne marche pas
# sur l'autre (dgx.cronos.website vs dgx.cronos.lan). REQUIRE_UV=1 exige PIN ou
# biométrie ; à 0, une YubiKey « touch-only » suffit.
WEBAUTHN_ORIGIN=https://dgx.cronos.website
WEBAUTHN_RP_ID=dgx.cronos.website
WEBAUTHN_RP_NAME=Cronos
WEBAUTHN_REQUIRE_UV=0

# ── Téléchargements Hugging Face ──
# Requis seulement pour les dépôts « gated » (certains GGUF le sont) : sans
# token autorisé, le téléchargement échoue par « Access denied ».
HF_TOKEN=

# ── Endpoints internes ──
# Les valeurs ci-dessous sont déjà celles par défaut dans le code : ne les
# renseigner que si un service bouge (renommage de conteneur, port changé).
# VLLM_RUNNER_URL et VLLM_API_URL passent par host.docker.internal, épinglé à
# 172.19.0.1 côté compose — ne pas le remplacer par host-gateway (cf. CLAUDE.md).
VLLM_RUNNER_URL=http://host.docker.internal:8001
VLLM_API_URL=http://host.docker.internal:8000/v1
VLLM_API_BASE=http://host.docker.internal:8000/v1
# Port 4001 : c'est celui sur lequel CE stack lance LiteLLM
# (docker-compose.yml, `--port 4001`) et celui qu'utilise Traefik. Le repli
# écrit dans le code est 4000 (le défaut amont de LiteLLM) : ne pas s'y fier,
# il ne répond pas ici.
LITELLM_URL=http://litellm:4001
OCR_URL=http://ocr:8000/v1
VOICE_URL=http://voice:8004
ASR_URL=http://asr:8006
IMAGE_URL=http://image:8007
MUSIC_URL=http://music:8008
COMFYUI_URL=http://host.docker.internal:8188
SEARXNG_URL=http://searxng:8080
CRAWL4AI_URL=http://crawl4ai:11235
# URL publique de l'API, affichée dans les extraits d'intégration du playground.
PUBLIC_API_URL=https://api.cronos.website/v1
# Alias LiteLLM qui suit toujours le modèle en cours : les clients le câblent une
# fois et ne le renomment plus à chaque bascule.
AUTO_MODEL_NAME=auto-model
# Fuseau affiché par le portail (le serveur peut rester en UTC).
TZ_DISPLAY=Europe/Paris
