# Installed by install.sh (§7c, mode 0440 required by sudo). Versioned since
# the 2026-10-01 audit: it only existed on the machine, so a rebuild silently
# disarmed Admin → Launch of the media sidecars.
#
# Scoped control of the OCR and voice containers (docker) and the ComfyUI video
# service (systemd), used by vllm-runner (runner.py, routes /ocr/*, /video/*
# and /voice/*) for the start/stop/relaunch requested from the dgx-portal
# admin. Fixed commands (start/stop/status), with no variable argument nor
# wildcard, except for ocr-recreate.sh (hf_model_id + vLLM flags) and
# voice-recreate.sh (repo_id) whose arguments are validated on the Python side
# (runner.py, _validate_vllm_args / closed allowlist for repo_id) before the
# sudo call — see each script for the detail of why it is safe even with
# variable arguments (never interpreted by a shell).
vllmrunner ALL=(root) NOPASSWD: /usr/bin/systemctl start comfyui.service
vllmrunner ALL=(root) NOPASSWD: /usr/bin/systemctl stop comfyui.service
vllmrunner ALL=(root) NOPASSWD: /usr/bin/systemctl is-active comfyui.service
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker start ocr
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker stop ocr
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker inspect ocr
vllmrunner ALL=(root) NOPASSWD: /usr/local/sbin/ocr-recreate.sh *
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker start voice
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker stop voice
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker inspect voice
vllmrunner ALL=(root) NOPASSWD: /usr/local/sbin/voice-recreate.sh *
vllmrunner ALL=(root) NOPASSWD: /usr/local/sbin/voice-qwen-recreate.sh *
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker start asr
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker stop asr
vllmrunner ALL=(root) NOPASSWD: /usr/bin/docker inspect asr
vllmrunner ALL=(root) NOPASSWD: /usr/local/sbin/asr-recreate.sh *
