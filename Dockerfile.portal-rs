# Build stage
FROM rust:1.99@sha256:53766005847cbe02c3f59bfa49c1c4bb16695f2c9e5829c3d576a15406f5e733 AS builder

WORKDIR /app

# Install cargo-chef for faster layer caching
RUN cargo install cargo-chef

COPY portal-rs/Cargo.* ./portal-rs/
WORKDIR /app/portal-rs

RUN cargo chef prepare --recipe-path recipe.json

RUN cargo chef cook --release --recipe-path recipe.json

COPY portal-rs/src ./src
# The ComfyUI video graphs are compiled in (include_str!, handlers/video_routes.rs).
COPY portal-rs/workflows ./workflows

RUN cargo build --release

# Runtime stage
FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3

RUN apt-get update && apt-get install -y \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/portal-rs/target/release/portal /usr/local/bin/

RUN useradd -u 10001 portal && mkdir -p /app && chown -R portal:portal /app /usr/local/bin/portal

USER portal
WORKDIR /app
EXPOSE 5100

CMD ["portal"]
