[Unit]
Description=CrOS health monitor — alerte email quand les services cœur sont down
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# Tourne en root : le .env (600) et le socket docker y sont accessibles.
ExecStart=/usr/bin/python3 /root/ai-platform/monitoring/monitor.py
TimeoutStartSec=60
# Durcissement (2026-09-24) : l'unité tourne en root sans qu'aucune de ces
# capacités ne lui serve. `ProtectSystem=strict` rend tout le système de
# fichiers en lecture seule (le .env reste LISIBLE, `ProtectHome=read-only` ne
# le cache pas) et `ReadWritePaths` n'ouvre que ce que le moniteur écrit :
# son état sticky, et `/root/.docker` (le CLI docker y touche son état buildx).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cronos-monitor /root/.docker
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
