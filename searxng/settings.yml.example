# SearXNG — settings of the playground's search engine.
#
# This file is a TEMPLATE: `setup.sh` copies it to `settings.yml` (not
# versioned, it then carries the generated secret) at first startup. The folder
# is mounted whole into the container (`./searxng:/etc/searxng`), so this is
# indeed the one being read, not the one shipped in the image.
#
# `use_default_settings: true`: we only redefine what matters, the rest comes
# from SearXNG's own defaults — an engine list copied here would have to be
# maintained at every version bump.
#
# Read the documentation before extending the defaults:
# https://docs.searxng.org/admin/settings/
use_default_settings: true

# CAREFUL: a single `server:` key is allowed. Two `server:` blocks in the same
# YAML document do NOT merge — the second silently overwrites the first, and
# `image_proxy` thus disappeared from the effective configuration.
server:
  secret_key: "changeme"
  image_proxy: true
  # The limiter blocks programmatic calls (no cookie, no referer). No risk
  # here: the service is reachable only from dgx-portal, on an internal docker
  # network, never exposed.
  limiter: false

search:
  # The JSON format is NOT enabled by default: without it, only the HTML page
  # exists and one would have to scrape it. This is the format the portal
  # consumes (`websearch.py` asks for `format=json`): without this section,
  # SearXNG answers 403 and web search falls — on the portal side, with no
  # clear message.
  formats:
    - html
    - json
