# Shared editor settings (VS Code, JetBrains, Sublime, Vim…).
#
# Why: the repo mixes Python (4 spaces), TypeScript/JSON/YAML (2 spaces) and
# shell scripts. Without this file, each machine applies its own settings and a
# plain « save » reformats the whole touched file, which drowns the real change
# in an unreadable diff.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.sh]
indent_size = 2

[*.{yml,yaml,json,jsonc,ts,tsx,js,jsx,css}]
indent_size = 2

[*.md]
# The two trailing spaces are Markdown syntax (forced line break): removing
# them would change how the README renders.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
