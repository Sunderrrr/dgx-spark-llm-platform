# Secrets & environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc

# Data volumes
portal_data/
postgres_data/

# Databases & dumps
*.db
*.sqlite
*.sqlite3
*.sql
*.dump

# Local backups / editor cruft
*.bak
*.orig
*~
.DS_Store

# Secrets material (never commit)
*.pem
*.key
*.crt
*.p12
id_rsa*
DEBUG_USERS.txt

# Logs
*.log

# Screenshots that contain real user data (leaderboard is per-user by name)
assets/ranking.png

# Users page screenshot contains internal usernames (like the leaderboard)
assets/users.png

# SearXNG configuration: settings.yml holds a secret generated at first
# startup, so it is not versioned. The TEMPLATE, on the other hand, must be
# versioned: without it, a fresh clone lets SearXNG write its default
# configuration — which does NOT enable the JSON format the portal expects —
# and web search answers 403 with nothing reporting it. The pattern excludes
# the CONTENT of the folder (not the folder itself), otherwise the negation
# below would have no effect: git cannot re-include a file whose parent folder
# is excluded.
searxng/*
!searxng/settings.yml.example

# Service tokens generated locally (crawl4ai). Never in git.
secrets/

# Machine-private security notes (operator-specific; never commit)
.machine/

# Operating guide (CLAUDE.md): read from disk by the operator and the agents
# working in the repo, but not published. The pattern without a slash also
# covers dgx-portal-frontend/CLAUDE.md. Not to be confused with
# dgx-portal-frontend/public/avatars/claude.svg, which is an image and stays
# tracked.
CLAUDE.md

# Runtime state shared between containers (proxy in-flight activity, read by
# the portal). Holds API key aliases and account names: never in git.
runtime/
